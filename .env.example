# Language-model providers (only the provider selected in Settings needs a key)
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional bearer token for an authenticated local OpenAI-compatible server
LOCAL_AI_API_KEY=

# Media generation
DEAPI_KEY=

# Optional Discord bot credential for the Discord bridge
DISCORD_BOT_TOKEN=

# Existing named Cloudflare Tunnel route for `python run_desktop.py --cloudflare`
# Point the public hostname to http://localhost:<port> in Cloudflare.
PETEY_CLOUDFLARE_HOSTNAME=
PETEY_CLOUDFLARE_PORT=8765

# Optional override; otherwise Petey uses the platform application-data directory.
# PETEY_DATA_DIR=/absolute/path/to/petey-data
