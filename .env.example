# Language-model providers (only the provider selected in Settings needs a key)
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional bearer token for an authenticated local OpenAI-compatible server
LOCAL_AI_API_KEY=

# Media generation
DEAPI_KEY=

# Optional override; otherwise Petey uses the platform application-data directory.
# PETEY_DATA_DIR=/absolute/path/to/petey-data
